# Configuration: generate private values with scripts/configure_local.py.
# Proposed Linux Compose paths. Do not use empty credentials in a running system.
APP_ENV=local
APP_TIMEZONE=Asia/Qyzylorda
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
POSTGRES_DB=saq_qurylys
POSTGRES_USER=saq_app
POSTGRES_PASSWORD=
# Build from POSTGRES_* or set a private connection string locally.
DATABASE_URL=
# Optional host override; defaults to <project>/storage. Compose sets /app/storage.
# STORAGE_ROOT=storage
SESSION_SECRET=
BOOTSTRAP_ANALYST_USERNAME=
BOOTSTRAP_ANALYST_PASSWORD=
SESSION_COOKIE_SECURE=false
# OCR/review slice settings, consumed by API and worker.
OCR_LANGUAGES=rus+kaz+eng
TESSERACT_COMMAND=tesseract
OCR_TIMEOUT_SECONDS=60
PDF_TIMEOUT_SECONDS=60
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
JOB_MAX_ATTEMPTS=2
JOB_LEASE_SECONDS=180
WORKER_POLL_SECONDS=1
# Planned parameters below are not consumed yet.
COLLECTOR_ENABLED=false
COLLECTOR_ALLOWED_HOSTS=
COLLECTOR_ALLOWED_PATH_PREFIXES=
COLLECTOR_USER_AGENT=
COLLECTOR_MAX_RESPONSE_BYTES=5242880
COLLECTOR_CONNECT_TIMEOUT_SECONDS=10
COLLECTOR_READ_TIMEOUT_SECONDS=30
JOB_TIMEOUT_SECONDS=120
PDF_FONT_PATH=/app/assets/fonts/NotoSans-Regular.ttf
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=OpenStreetMap contributors
LLM_ENABLED=false
