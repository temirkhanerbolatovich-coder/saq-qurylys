# Configuration: generate private values with scripts/configure_local.py.
# Proposed Linux Compose paths. Do not use empty credentials in a running system.
APP_ENV=local
APP_TIMEZONE=Asia/Qyzylorda
APP_BIND_HOST=127.0.0.1
APP_PORT=3000
APP_ORIGIN=http://localhost:3000
POSTGRES_DB=saq_qurylys
POSTGRES_USER=saq_app
POSTGRES_PASSWORD=
# Build from POSTGRES_* or set a private connection string locally.
DATABASE_URL=
# Optional host override; defaults to <project>/storage. Compose sets /app/storage.
# STORAGE_ROOT=storage
SESSION_SECRET=
BOOTSTRAP_ANALYST_USERNAME=
BOOTSTRAP_ANALYST_PASSWORD=
SESSION_COOKIE_SECURE=false
# Compose startup only: always ensure the configured analyst exists without resetting an existing account.
# true also adds DEMO fixtures; false adds no DEMO data and preserves existing imported records.
# Only literal true/false are accepted. Defaults to true when unset.
DEMO_SEED_ENABLED=true
# OCR/review slice settings, consumed by API and worker.
OCR_LANGUAGES=rus+kaz+eng
TESSERACT_COMMAND=tesseract
OCR_TIMEOUT_SECONDS=60
PDF_TIMEOUT_SECONDS=60
DOCUMENT_PDF_TIMEOUT_SECONDS=12
PDF_PROXY_TIMEOUT_MS=75000
PDF_VALIDATION_TIMEOUT_SECONDS=10
PDF_MAX_PAGES=100
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
JOB_MAX_ATTEMPTS=2
JOB_LEASE_SECONDS=180
WORKER_POLL_SECONDS=1
# Optional Telegram notifications. Pair a private chat using scripts/configure_telegram.py.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_INCLUDE_DEMO=false
TELEGRAM_TIMEOUT_SECONDS=10
TELEGRAM_MAX_ATTEMPTS=3
# Optional public HTTPS UI URL; leave empty for a local-only installation.
TELEGRAM_WEB_BASE_URL=
# Explicit analyst Threads search preview; disabled until official API access is configured.
THREADS_SEARCH_ENABLED=false
THREADS_ACCESS_TOKEN=
THREADS_SEARCH_TIMEOUT_SECONDS=10
THREADS_SEARCH_INTERVAL_SECONDS=30
# Public frontend BUILD arguments; rebuild frontend after changing. Use "disabled" to disable tiles.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
# Planned parameters below are not consumed yet.
COLLECTOR_ENABLED=false
COLLECTOR_ALLOWED_HOSTS=
COLLECTOR_ALLOWED_PATH_PREFIXES=
COLLECTOR_USER_AGENT=
COLLECTOR_MAX_RESPONSE_BYTES=5242880
COLLECTOR_CONNECT_TIMEOUT_SECONDS=10
COLLECTOR_READ_TIMEOUT_SECONDS=30
JOB_TIMEOUT_SECONDS=120
PDF_FONT_PATH=/app/assets/fonts/NotoSans-Regular.ttf
LLM_ENABLED=false

# Reviewed URL schedules: each new schedule is OFF until explicitly enabled.
URL_SCHEDULE_POLL_SECONDS=30
URL_SCHEDULE_SOURCE_INTERVAL_SECONDS=300
URL_SCHEDULE_SOURCE_HOURLY_LIMIT=12
